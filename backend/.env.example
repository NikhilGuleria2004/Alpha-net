MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alphanet?retryWrites=true&w=majority
MONGODB_DB_NAME=alphanet
JWT_SECRET=change-me-in-production
CRON_SECRET=change-me-in-production
ADMIN_REGISTRATION_SECRET=change-me-in-production
BLOB_READ_WRITE_TOKEN=change-me-in-production
# Comma-separated origins allowed to call the API cross-origin.
# Used by CORS and by the cross-origin refresh-cookie guard (middleware/csrf.js).
# Keep this in sync with every frontend URL you deploy.
FRONTEND_URL=http://localhost:5173,https://alphanet-navy.vercel.app
PORT=3001

# --- AI assistant -----------------------------------------------------------
# Which provider the assistant talks to: "groq" | "gemini".
# Leave unset to auto-detect (Groq when GROQ_API_KEY exists, else Gemini).
AI_PROVIDER=groq

# Groq (current default). Get a key at https://console.groq.com/keys
GROQ_API_KEY=change-me-in-production
# Override the model if you want a different Groq model.
GROQ_MODEL=openai/gpt-oss-20b

# Gemini — kept so the AI_PROVIDER switch is the only change needed to go back.
GEMINI_API_KEY=change-me-in-production
GEMINI_MODEL=gemini-2.5-flash

# Base URL the AI layer uses to call THIS app's own REST API as the signed-in
# user. In production set it to the public origin (localhost is wrong there).
INTERNAL_API_BASE_URL=http://localhost:3001/api/v1

# Optional AI rate limits (per user). Defaults: 100/min dev, 30/min prod.
AI_CHAT_RATE_LIMIT_PER_USER=30
AI_CHAT_RATE_LIMIT_WINDOW_MS=60000
# How long a staged write action stays confirmable. Default 10 minutes.
AI_PENDING_ACTION_TTL_MS=600000
