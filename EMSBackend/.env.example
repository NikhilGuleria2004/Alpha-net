# ── Runtime ────────────────────────────────────────────────────────────
# PORT is ignored on Vercel (the platform assigns it); it applies locally.
PORT=8787
NODE_ENV=development

# ── Database (shared with the timesheet platform backend) ──────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alphanet?retryWrites=true&w=majority
MONGODB_DB_NAME=alphanet
# Pool sizing. Every function instance builds its own pool, so under horizontal
# scale these are multiplied by the instance count against one shared Atlas
# connection limit. Defaults are smaller on Vercel (5 / 0) than locally (10 / 1);
# override only if you have measured a need.
# MONGODB_MAX_POOL_SIZE=5
# MONGODB_MIN_POOL_SIZE=0

# ── JWT ─────────────────────────────────────────────────────────────────
# HS256 secret (use a long random value in production).
JWT_SECRET=change-me-in-production
# Access token TTL (jose duration unit). Default: 15m.
JWT_ACCESS_TTL=15m
# Refresh token TTL (jose duration unit). Default: 30d.
JWT_REFRESH_TTL=30d

# ── Cookie topology — READ THIS BEFORE DEPLOYING ────────────────────────
# The refresh cookie is the entire auth session, so this decides whether users
# stay logged in.
#
#   lax    SPA and API share a *site* (same registrable domain).
#   none   SPA and API are on different sites. Required when the frontend is
#          on one *.vercel.app host and this API is on another.
#
# `vercel.app` is on the Public Suffix List, so every <name>.vercel.app is its
# own registrable domain and therefore its own cookie site. Two different
# *.vercel.app hosts are cross-site: with `lax` the browser withholds the
# refresh cookie from fetch(), login appears to work and then every later
# request is logged out. `none` is safe here because Vercel serves HTTPS, and
# the cookie is forced Secure whenever this is set.
#
# Set to `none` unless the API and the SPA share a registrable domain (e.g.
# both under a custom domain you control, like app.acme.com + api.acme.com).
# COOKIE_SAME_SITE=none

# ── CORS (comma-separated origins allowed to call the API) ────────────
# Used by CORS middleware and the cross-origin-cookie guard (middleware/csrf.ts).
# REQUIRED in production: validateEnv fails startup without it, because an API
# that falls back to the localhost default rejects all real browser traffic
# while still answering curl and health checks.
CORS_ORIGINS=http://localhost:5173,https://alphanet-navy.vercel.app

# ── Rate limiting ──────────────────────────────────────────────────────
AUTH_RATE_LIMIT_PER_USER=30
AUTH_RATE_LIMIT_PER_IP=60
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Shared counter store. Without it, limits are kept in each instance's memory,
# so N instances grant N times the intended rate — the auth limiters above then
# stop being a brute-force control. Set this in production.
# REDIS_URL=redis://user:password@host:6379

# ── Email (SMTP) ────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to use the dev console-transport (log only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@eniac.local

# ── App URL (for invite/reset email links) ─────────────────────────────
APP_URL=http://localhost:5173
