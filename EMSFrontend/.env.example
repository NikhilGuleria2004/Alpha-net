# EMS frontend environment (Vite — only VITE_-prefixed vars reach the client).
#
# VITE_API_BASE_URL: base URL of the EMS API (Cloudflare Workers backend).
#   - Dev: use the relative "/api/v1" so the Vite dev proxy forwards it to the
#     local backend (see vite.config.ts → localhost:8787).
#   - Prod: set the deployed Worker origin, e.g. https://ems-api.<acct>.workers.dev/api/v1
VITE_API_BASE_URL=/api/v1

# VITE_USE_MOCK: when "true", the app resolves service calls from the typed mock
# adapter instead of hitting the network. Kept true for the whole shell phase
# (Phases 2–7) and flipped to false in Phase 8 when the real API is wired.
VITE_USE_MOCK=true
