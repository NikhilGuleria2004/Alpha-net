# Production build for Hostinger (static dist/), served over HTTPS.
#
# The SPA is served from the Hostinger domain and calls the Vercel-hosted EMS
# API cross-origin, so the backend must be configured to match:
#   CORS_ORIGINS     = this site's origin (scheme + host, no trailing slash)
#   COOKIE_SAME_SITE = none
# `eniacinc.com` and `vercel.app` are different registrable domains, so the
# browser treats this as cross-site: with `lax` the refresh cookie is withheld
# from fetch() and every page load ends in a logout. `none` is safe only because
# the cookie is forced Secure, which requires this site to be served over HTTPS.
VITE_API_BASE_URL=https://eniac-ems.vercel.app/api/v1

# Phase 8: real backend, not the fixture adapter.
VITE_USE_MOCK=false
