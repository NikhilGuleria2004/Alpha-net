# SPA history fallback.
#
# The app uses createBrowserRouter (history-based URLs), so a hard refresh or
# shared link on /admin/employees, /hr/employees, /me/profile and friends must
# serve index.html. Without this the server returns 404 for every deep link,
# which looks like the app being broken even though it works on the root URL.
#
# Hostinger serves Apache/LiteSpeed, so this is the file that matters. The
# -f/-d guard passes real files and directories straight through, so hashed
# assets under /assets and the files in /fonts are never rewritten.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Hashed filenames under /assets are safe to cache indefinitely.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# index.html must never be cached, or clients keep booting an old asset graph
# after a deploy and hit 404s on files that no longer exist.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
